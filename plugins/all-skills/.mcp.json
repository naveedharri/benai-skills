{
  "apify": {
    "type": "http",
    "url": "https://mcp.apify.com"
  },
  "nano-banana": {
    "command": "npx",
    "args": [
      "-y",
      "@zhibinyang/nano-banana-mcp"
    ],
    "env": {}
  },
  "webflow": {
    "type": "http",
    "url": "https://mcp.webflow.com/mcp"
  },
  "youtube": {
    "command": "npx",
    "args": [
      "-y",
      "@kirbah/mcp-youtube"
    ],
    "env": {
      "YOUTUBE_API_KEY": ""
    }
  }
}
