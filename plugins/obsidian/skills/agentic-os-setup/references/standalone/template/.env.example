# Copy to .env.local and fill in. Do NOT commit .env.local.

# Required: powers all Agent SDK snapshot refresh runs.
ANTHROPIC_API_KEY=

# Required when running in a root container (Railway, most Dockers).
# Tells the Agent SDK to allow --dangerously-skip-permissions under root.
IS_SANDBOX=1

# Basic auth gating every route. Leave both blank locally to disable auth.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# --- MCP keys (only set the ones you actually use) ---
MCP_CIRCLE_KEY=
MCP_FIREFLIES_KEY=
MCP_YOUTUBE_API_KEY=
MCP_VIDIQ_KEY=
MCP_APIFY_KEY=
MCP_UNIPILE_KEY=
MCP_REDDIT_URL=

# --- Tenant identifiers (used inside snapshot prompts) ---
UNIPILE_BASE_URL=
UNIPILE_LINKEDIN_ACCOUNT_ID=
CIRCLE_OWNER_EMAIL=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=

# Optional: override which profile gets the synthesis-leaning overview.
PRIMARY_PROFILE=

# Optional: email domain used to match team members against meeting attendees.
NEXT_PUBLIC_PROFILE_EMAIL_DOMAIN=
NEXT_PUBLIC_PRIMARY_PROFILE=
